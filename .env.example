# Secrets for the local hub demo (never commit real values)

# OIDC secret for the demo client einvoice-client (api seeds it; UI and API tests use it)
OIDC_CLIENT_SECRET=

# OIDC secret for the read-only worker client einvoice-worker (api seeds it)
OIDC_WORKER_CLIENT_SECRET=

# PostgreSQL password for the demo database
POSTGRES_PASSWORD=

# RabbitMQ credentials (defaults work for the local demo)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Silo (MinIO-compatible) root credentials for the local demo
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
